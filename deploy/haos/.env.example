# Copy to deploy/haos/.env. Use the Windows host's LAN IPv4 address, not the HA VM address.
BAPSIM_MQTT_BIND_IP=192.0.2.10

# Record these installation choices separately; Compose does not consume them.
# HA_URL=http://192.168.1.13:8123
# HA_HOUSEHOLD_ID=household_01
# A05_DEVICE_ID=cooker_01
# A05_REPORT_ENTITY_ID=sensor.a05_reportcounter
# A05_MATTER_ENTRY_ID=<confirm in this HA installation>
# A05_NODE_ID=<confirm in this HA installation>
# HA_NOTIFY_SERVICE=mobile_app_<test_phone>
